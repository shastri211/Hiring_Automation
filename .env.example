# -------------------------
# Application
# -------------------------
STORAGE_LOCAL_DIR=uploads
RETRIEVAL_TOP_K=20

# Comma-separated list of origins allowed to call the API (the frontend-v2 dev
# server origin by default; add your deployed frontend origin(s) in production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------
# Database
# -------------------------
POSTGRES_USER=screener
POSTGRES_PASSWORD=screener_password
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=resume_screener

# -------------------------
# Redis
# -------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# -------------------------
# Qdrant
# -------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=resume_candidates_768
QDRANT_COLLECTION_V2=resume_candidates_v2_768
QDRANT_COLLECTION_LOCAL_V2=resume_candidates_local_v2_384

# -------------------------
# Embeddings
# -------------------------
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -------------------------
# LLM Providers & Keys
# -------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# -------------------------
# LLM Models
# -------------------------
GROQ_MODELS=qwen/qwen3.8-27b
GEMINI_MODELS=gemini-3.6-flash
OPENROUTER_MODELS=google/gemma-4-31b-it:free
NVIDIA_MODELS=meta/llama3-70b-instruct
# GEMINI_OCR_MODEL=  # Optional: override the Gemini model used for document OCR/image extraction.
#                    # Defaults to the first model in GEMINI_MODELS when not set.

# -------------------------
# LLM Resilience Settings
# -------------------------
LLM_PROVIDER_PRIORITY=groq,gemini,openrouter,nvidia
LLM_COOLDOWN_SECONDS=60
LLM_TIMEOUT_SECONDS=30

# -------------------------
# Local Resume Profiler
# -------------------------
LOCAL_PROFILE_CONFIDENCE_THRESHOLD=45

# -------------------------
# Email (Resend)
# -------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@automatedhiring.com

# -------------------------
# Adaptive Semantic Gate
# -------------------------
MIN_CANDIDATES_TO_SCREEN=5
MAX_CANDIDATES_TO_SCREEN=20
SEMANTIC_GAP_THRESHOLD=0.05

# -------------------------
# Worker Settings
# -------------------------
WORKER_ID=resume-worker-1
WORKER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF_SECONDS=60
WORKER_CONSUMER_GROUP=resume-screeners
WORKER_CONCURRENCY=5
